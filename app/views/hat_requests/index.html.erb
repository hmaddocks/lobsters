<% if @hat_requests.empty? %>
  No hat requests.
<% else %>
<table class="data zebra" width="100%" cellspacing="0">
<tr>
  <th>Hat</th>
  <th>Link</th>
  <th>Comment</th>
</tr>
    <% @hat_requests.each do |hat_request| %>
      <tr>
        <td><%= hat_request.hat %></td>
        <td><%= hat_request.link %></td>
        <td><%= hat_request.comment %></td>
      </tr>
  <% end %>
  </table>
<% end %>
